{
  "expo": {
    "name": "Dehradun Coaching",
    "slug": "test-paper-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Download icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dehraduncoaching.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDFBF6",
        "foregroundImage": "./assets/Download icon.png"
      },
      "package": "com.dehraduncoaching.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow the app to access your photos to upload category, series, and question images."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/Download icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a38c020b-1437-49ec-b4ef-c41b1346e43c"
      }
    }
  }
}
